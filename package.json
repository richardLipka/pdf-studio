{
  "name": "pdf-studio",
  "version": "2.0.0",
  "description": "Client-side privacy-first PDF editor, annotator, and PAdES signer",
  "author": "Richard Lipka <lipka@fav.zcu.cz>",
  "homepage": "https://github.com/richardLipka/pdf-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardLipka/pdf-studio.git"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:build-scripts": "node scripts/build-electron.cjs",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"node scripts/wait-for-vite.cjs && npm run electron:build-scripts && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "electron:build": "npm run build && npm run electron:build-scripts",
    "electron:pack": "npm run electron:build && electron-builder --dir",
    "electron:dist": "npm run electron:build && electron-builder",
    "electron:dist:nsis": "npm run electron:build && electron-builder --win nsis",
    "electron:dist:portable": "npm run electron:build && electron-builder --win portable",
    "electron:dist:zip": "npm run electron:build && electron-builder --win zip"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "signature_pad": "^5.0.4",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "cz.zcu.fav.pdfstudio",
    "productName": "PDF Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Studio",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "zip": {
      "artifactName": "${productName}-win-x64-${version}.${ext}"
    }
  }
}
